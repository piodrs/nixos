[global]
width = 320
height = 180
origin = top-right
offset = 12x32
notification_limit = 4
font = Iosevka 10
format = "<b>%s</b>\n%b"
alignment = left
vertical_alignment = center
padding = 10
horizontal_padding = 10
text_icon_padding = 10
frame_width = 1
frame_color = "#3a3a3a"
separator_height = 1
separator_color = frame
corner_radius = 0
progress_bar = false
icon_position = left
min_icon_size = 24
max_icon_size = 32
markup = full
word_wrap = true
ellipsize = end
history_length = 10
mouse_left_click = close_current
mouse_right_click = close_all

[urgency_low]
background = "#101010"
foreground = "#a0a0a0"
timeout = 4

[urgency_normal]
background = "#101010"
foreground = "#e0e0e0"
timeout = 6

[urgency_critical]
background = "#101010"
foreground = "#ffcc66"
frame_color = "#ffcc66"
timeout = 0
